# Cursor Agent CLI binary (optional if `agent` is already on PATH)
# Windows example: %LOCALAPPDATA%\cursor-agent\agent.cmd
# Linux/macOS example: /home/you/.local/bin/agent
AGENT_BIN=

# Workspace the agent edits. Default: parent repo if this lives in third_party/, else cwd.
AGENT_WORKSPACE=

# Web server
AGENT_WEB_HOST=0.0.0.0
AGENT_WEB_PORT=8786

# Required on first run if secrets.json has no password_hash.
# This value is hashed into secrets.json; it is not stored in plaintext.
AGENT_WEB_PASSWORD=

# Optional. Can also be pasted in the web Settings panel.
CURSOR_API_KEY=

# Default model id
AGENT_MODEL=composer-2.5

# Optional HTTP proxy for Cursor Agent CLI (does not use Windows system proxy).
# If unset, the server copies a live Clash/system proxy (e.g. 127.0.0.1:7897).
# HTTPS_PROXY=http://127.0.0.1:7897
# AGENT_HTTPS_PROXY=http://127.0.0.1:7897
# CURSOR_CHATS_ROOT=
# Optional override of Cursor IDE project folders (agent-transcripts)
# CURSOR_PROJECTS_ROOT=
# AGENT_WEB_SESSION_DAYS=7
